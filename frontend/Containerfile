# The build output is plain static files, so build on the machine's own architecture
# ($BUILDPLATFORM) instead of under emulation when producing arm64 images.
FROM --platform=$BUILDPLATFORM docker.io/library/node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM docker.io/library/nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
